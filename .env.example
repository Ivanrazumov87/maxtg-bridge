# ── MAX ───────────────────────────────────────────────
# Токен веб-сессии MAX (см. инструкцию в README / в группе проекта)
MAX_TOKEN=

# ID группы MAX, которую зеркалим в Telegram (привязка одна-к-одной).
# Узнать: откройте web.max.ru, зайдите в нужную группу — ID в адресной строке
# (https://web.max.ru/ID_ГРУППЫ).
MAX_GROUP_ID=

# ── Telegram ──────────────────────────────────────────
# Токен бота от @BotFather
TG_BOT_TOKEN=

# ID обычной группы Telegram, привязанной к группе MAX (обычно начинается с -100...).
# Бот должен быть добавлен в группу. Чтобы он видел ВСЕ сообщения группы,
# сделайте его администратором ЛИБО отключите privacy mode:
#   @BotFather -> /setprivacy -> выберите бота -> Disable.
# Узнать ID: перешлите боту @my_id_bot любое сообщение из группы.
TG_GROUP_ID=

# Необязательно: ID чата для мониторинга состояния бота (встал/упал).
MONITOR_ID=
